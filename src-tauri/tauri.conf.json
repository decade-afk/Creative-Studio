{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creative Studio",
  "version": "0.3.2",
  "identifier": "com.creativestudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright © 2026 ADream-ki",
    "shortDescription": "专业创作工作室：小说/剧本写作、AI 辅助创作、大纲与分镜管理",
    "longDescription": "Creative Studio 是面向中文创作者的一体化写作工作台：小说与短剧双模式编辑、大纲与角色规划、伏笔与冲突管理、AI 辅助创作（续写/润色/摘要/审稿）、全文检索、版本快照、多格式导出与本地自动备份。支持接入 Kimi、DeepSeek、GLM、OpenAI、OpenRouter 及 LM Studio、Ollama 等本地模型。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Creative Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: asset: http://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ws://localhost:* http://localhost:* http://asset.localhost; media-src 'self' asset: http://asset.localhost; object-src 'none'; frame-src 'none';",
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGNTRBMEQzMTIwQUYwMjYKUldRbThBb1MwNkJVMzZ1TFNEVHRYMm5KdTNzQ3RXZkJ0WG1KTi9tZ1dFNzRYQ09Ub2VFTWFUNzkK",
      "endpoints": [
        "https://github.com/decade-afk/Creative-Studio/releases/latest/download/latest.json"
      ]
    }
  }
}
